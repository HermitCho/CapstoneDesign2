--- !u!114 &8288982245685517470
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8507291764291876452}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 700c87c41315868459694e41b1592a78, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messageText: {fileID: 7532243028886668733}
  tutorialMessages:
  - "\uD29C\uD1A0\uB9AC\uC5BC\uC5D0 \uC624\uC2E0 \uAC78 \uD658\uC601\uD569\uB2C8\uB2E4!"
  - "\uC774\uB3D9\uD558\uB824\uBA74 WASD \uD0A4\uB97C \uB20C\uB7EC \uBCF4\uC138\uC694.\nSpace
    \uD0A4\uB85C \uC810\uD504\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uBC14\uB2E5\uC5D0 \uC788\uB294 \uD654\uC0B4\uD45C\uB97C\n\uB530\uB77C\uAC00\uC138\uC694."
  - "\uC606\uC5D0 \uBCF4\uC774\uB294 \uC801\uC744 \uD574\uCE58\uC6CC\n\uBB38\uC744
    \uC5F4\uC5B4\uBCF4\uC138\uC694!"
  - "\uB9C8\uC6B0\uC2A4 \uC88C\uD074\uB9AD\uC744 \uD1B5\uD574\n\uCD1D\uC744 \uBC1C\uC0AC\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
  - "\uBB38\uC774 \uC5F4\uB838\uC2B5\uB2C8\uB2E4. \n\uB2E4\uC74C \uAD6C\uC5ED\uC73C\uB85C
    \uC774\uB3D9\uD558\uC138\uC694!"
  - "\uC0C1\uC810\uC5D0\uC11C \uC2A4\uD0AC\uB4E4\uC744 \uAD6C\uB9E4\uD574\n\uC0AC\uC6A9\uD574\uBCF4\uC138\uC694!"
  - "\uC774\uC81C \uC2E4\uC804 \uC900\uBE44\uAC00 \n\uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4!"
  messageDuration: 3
  fadeTime: 1
